# Generate a unique random value with at least 32 characters. Store only in the runner and API service.
SANDBOX_SERVICE_TOKEN=replace-with-a-long-random-secret-value
# Digest-pinned production image recommended after the approved image is published.
SANDBOX_NODE_IMAGE=node:22-alpine
SANDBOX_PUBLIC_ORIGIN=https://preview.example.com
SANDBOX_FRAME_ORIGINS=https://sigmagpt.example.com
# Bind to a private interface address reachable only by the API and TLS reverse proxy.
SANDBOX_BIND_IP=127.0.0.1
